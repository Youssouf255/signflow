# Image unique pour un PaaS gratuit (Render, etc.).
# Sans LibreOffice : les PDF se signent ; Word/Excel restent à tester en local / VPS.

FROM node:20-alpine AS frontend
WORKDIR /app
ENV NODE_OPTIONS=--max-old-space-size=2048
ENV NG_BUILD_MAX_WORKERS=1
ENV CI=false
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install --legacy-peer-deps
COPY frontend/ ./
RUN mkdir -p public \
 && (cp -f node_modules/pdfjs-dist/build/pdf.worker.min.mjs public/pdf.worker.min.mjs \
  || cp -f node_modules/pdfjs-dist/legacy/build/pdf.worker.min.mjs public/pdf.worker.min.mjs \
  || true)
RUN npm run build -- --configuration production
RUN mkdir -p dist/frontend/browser \
 && (cp -f public/pdf.worker.min.mjs dist/frontend/browser/pdf.worker.min.mjs \
  || cp -f node_modules/pdfjs-dist/build/pdf.worker.min.mjs dist/frontend/browser/pdf.worker.min.mjs \
  || cp -f node_modules/pdfjs-dist/legacy/build/pdf.worker.min.mjs dist/frontend/browser/pdf.worker.min.mjs \
  || true)

FROM php:8.4-cli-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
        git unzip curl nginx gettext-base ca-certificates openssl \
        libpng-dev libjpeg62-turbo-dev libfreetype6-dev \
        libpq-dev libicu-dev libzip-dev libonig-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) pdo pdo_pgsql mbstring exif pcntl bcmath gd intl zip \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
WORKDIR /var/www/html

COPY backend/composer.json backend/composer.lock ./
RUN composer install --no-dev --no-scripts --prefer-dist --no-interaction --optimize-autoloader

COPY backend/ ./
RUN composer install --no-dev --prefer-dist --no-interaction --optimize-autoloader \
    && mkdir -p storage/framework/cache storage/framework/sessions storage/framework/views storage/logs bootstrap/cache storage/app/documents storage/app/pending-mail \
    && chown -R www-data:www-data storage bootstrap/cache

COPY backend/docker/php-prod.ini /usr/local/etc/php/conf.d/signflow.ini
COPY cloud/nginx.conf.template /etc/nginx/templates/signflow.conf.template
COPY cloud/entrypoint.sh /entrypoint.sh
COPY cloud/write-db-env.php /write-db-env.php
COPY --from=frontend /app/dist/frontend/browser /usr/share/nginx/html

RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh \
    && rm -f /etc/nginx/sites-enabled/default

ENV LIBREOFFICE_PATH=/usr/bin/soffice
EXPOSE 10000
ENTRYPOINT ["/entrypoint.sh"]
