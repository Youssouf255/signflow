FROM php:8.4-cli-bookworm

RUN printf 'Acquire::Retries "5";\nAcquire::http::Timeout "30";\n' > /etc/apt/apt.conf.d/80-retries

# LibreOffice is a separate layer so a later PHP-ext failure does not redo this download.
# Retry in-place so already-fetched .deb files are reused after a DNS/network drop.
RUN set -eux; \
    n=0; \
    until [ "$n" -ge 6 ]; do \
      apt-get update && apt-get install -y --no-install-recommends --fix-missing \
        git unzip curl \
        libpng-dev libjpeg62-turbo-dev libfreetype6-dev \
        libpq-dev libicu-dev libzip-dev libonig-dev \
        libreoffice-writer libreoffice-calc \
        fonts-dejavu-core \
      && break; \
      n=$((n+1)); \
      echo "apt-get retry ${n}/6"; \
      sleep 20; \
    done; \
    rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y --no-install-recommends $PHPIZE_DEPS \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) pdo pdo_pgsql mbstring exif pcntl bcmath gd intl zip \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apt-get purge -y --auto-remove $PHPIZE_DEPS \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --prefer-dist --no-interaction --optimize-autoloader

COPY . .
RUN composer install --no-dev --prefer-dist --no-interaction --optimize-autoloader \
    && mkdir -p storage/framework/cache storage/framework/sessions storage/framework/views storage/logs bootstrap/cache storage/app/documents \
    && chown -R www-data:www-data storage bootstrap/cache

COPY docker/php-prod.ini /usr/local/etc/php/conf.d/signflow.ini
COPY docker/entrypoint.prod.sh /entrypoint.prod.sh
RUN sed -i 's/\r$//' /entrypoint.prod.sh && chmod +x /entrypoint.prod.sh

ENV LIBREOFFICE_PATH=/usr/bin/soffice

EXPOSE 8000
ENTRYPOINT ["/entrypoint.prod.sh"]
CMD ["php", "artisan", "serve", "--host=0.0.0.0", "--port=8000"]
